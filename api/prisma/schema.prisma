generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS compiles to CommonJS; the generator's ESM default emits
  // `import.meta.url`, which is a runtime SyntaxError under CJS.
  moduleFormat = "cjs"
  runtime      = "nodejs"
  // Emit extensionless relative imports so both tsc and ts-node resolve the
  // generated .ts sources (a ".js" specifier has no file to point at here).
  importFileExtension = ""
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         String
  createdAt    DateTime @default(now())

  Cart          Cart[]
  orders        Order[]
  refreshTokens RefreshToken[]
}

/// One row per issued refresh token. Only the SHA-256 hash of the token is
/// stored, so a database leak does not hand out usable sessions.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  /// Rotation lineage: every token minted from the same login shares a familyId.
  /// Replaying a rotated token revokes the whole family.
  familyId  String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  /// Set when the token is rotated away, logged out, or revoked by reuse detection.
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  products Product[]
}

model Product {
  id         Int     @id @default(autoincrement())
  sku        String  @unique
  name       String
  price      Int
  stock      Int
  catagoryId Int?
  isActive   Boolean
  imageUrl   String? @db.Text
  images     String? @db.Text

  cartItems  CartItem[]
  orderItems OrderItem[]

  catagory Category? @relation(fields: [catagoryId], references: [id])
}

model Cart {
  id     Int     @id @default(autoincrement())
  userId Int?
  status Boolean

  CartItem CartItem[]

  user User? @relation(fields: [userId], references: [id])
}

model CartItem {
  id        Int  @id @default(autoincrement())
  cartId    Int?
  productId Int?
  quantity  Int

  cart    Cart?    @relation(fields: [cartId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
}

model Order {
  id                Int      @id @default(autoincrement())
  userId            Int?
  status            Boolean
  total             Int
  promotionId       Int?
  discountBreakdown Json
  createdAt         DateTime

  orderItems OrderItem[]

  promotion       Promotion?       @relation(fields: [promotionId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
  idempotencyKeys IdempotencyKey[]
}

model OrderItem {
  id        Int  @id @default(autoincrement())
  orderId   Int?
  productId Int?

  order   Order?   @relation(fields: [orderId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
}

model Promotion {
  id         Int      @id @default(autoincrement())
  code       String
  type       String
  value      Int
  usageLimit Int
  usedCount  Int
  expiresAt  DateTime
  orders     Order[]
}

model IdempotencyKey {
  id              Int    @id @default(autoincrement())
  key             String @unique
  orderId         Int?
  responsePayload Json

  order Order? @relation(fields: [orderId], references: [id])
}