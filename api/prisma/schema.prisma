generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  role         String

  Cart   Cart[]
  orders Order[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  products Product[]
}

model Product {
  id         Int     @id @default(autoincrement())
  sku        String  @unique
  name       String
  price      Int
  stock      Int
  catagoryId Int?
  isActive   Boolean

  cartItems  CartItem[]
  orderItems OrderItem[]

  catagory Category? @relation(fields: [catagoryId], references: [id])
}

model Cart {
  id     Int     @id @default(autoincrement())
  userId Int?
  status Boolean

  CartItem CartItem[]

  user User? @relation(fields: [userId], references: [id])
}

model CartItem {
  id        Int  @id @default(autoincrement())
  cartId    Int?
  productId Int?
  quantity  Int

  cart    Cart?    @relation(fields: [cartId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
}

model Order {
  id                Int      @id @default(autoincrement())
  userId            Int?
  status            Boolean
  total             Int
  promotionId       Int?
  discountBreakdown Json
  createdAt         DateTime

  orderItems OrderItem[]

  promotion       Promotion?       @relation(fields: [promotionId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
  idempotencyKeys IdempotencyKey[]
}

model OrderItem {
  id        Int  @id @default(autoincrement())
  orderId   Int?
  productId Int?

  order   Order?   @relation(fields: [orderId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
}

model Promotion {
  id         Int      @id @default(autoincrement())
  code       String
  type       String
  value      Int
  usageLimit Int
  usedCount  Int
  expiresAt  DateTime
  orders     Order[]
}

model IdempotencyKey {
  id              Int    @id @default(autoincrement())
  key             String @unique
  orderId         Int?
  responsePayload Json

  order Order? @relation(fields: [orderId], references: [id])
}
