DATABASE_URL="mysql://myuser:mypassword@127.0.0.1:3306/myweb"

# API listens here; Next dev server owns 3000.
PORT=3001

# Signing key for short-lived access tokens. Rotate this and every access token dies.
JWT_ACCESS_SECRET="_Jw8NqKMZ8eFRN92mNn6imGmXCVsAs2KbBFaHsJur3c5lfkdV2jdRHIXvaVvVdAQ"
JWT_ACCESS_TTL="1m"

# Refresh tokens are opaque random strings stored hashed in the DB, so they need
# no signing key - only a lifetime.
REFRESH_TOKEN_TTL_DAYS=7

# Browser origin allowed to call this API directly (used only if you bypass the BFF).
CORS_ORIGIN="http://localhost:3000"
